{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "es2015",
      "es2016",
      "es2017",
      "es2018",
      "es2019"
    ],
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    "incremental": true
  },
  "include": [
    "./app",
    "./src",
    "./workers",
    "./react-router.config.ts",
    "./vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
